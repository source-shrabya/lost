# Copy to .env and fill in what you have. Never commit .env.

# AI (optional). Without it, Lost uses Claude Code's `claude -p` if installed, else runs with AI off.
ANTHROPIC_API_KEY=
# LOST_AI=api|cli|off
# LOST_MODEL=claude-haiku-5-5

# Transcription (optional). Without it: local Moonshine (Python setup), else Chrome speech recognition.
DEEPGRAM_API_KEY=
# TRANSCRIBER=deepgram|moonshine|whisper|off

# Public https address of this server. Needed for Canvas OAuth redirects and join links.
PUBLIC_URL=

# Canvas OAuth developer key, issued by USM's Canvas administrators (usm.instructure.com).
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Testing only: the developer's own Canvas token. Never ask other users for theirs.
# CANVAS_DEV_TOKEN=

# Accounts
# Professors sign up with this invite code. Leave empty to turn professor sign-up off.
PROF_SIGNUP_CODE=
# Demo accounts and sample Canvas data: on by default, off when NODE_ENV=production.
# LOST_DEMO=0
# 64 hex characters used to encrypt stored Canvas tokens. Generated into data/secret.key if unset.
# LOST_SECRET=

# PORT=3000
# LOST_DATA=./data

# AI illustrations (optional), drawn by Cloudflare Workers AI FLUX.1 schnell when a student taps
# "Show illustration". Token needs the Workers AI permission. Off unless IMAGE_GENERATION_ENABLED=true.
# Free plan: 10,000 neurons a day, about 58 per 1024px image; past that, Free accounts get an error (no charge),
# Paid accounts are billed. IMAGE_DAILY_MAX keeps Lost under the free allowance.
IMAGE_GENERATION_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# IMAGE_DAILY_MAX=120
# IMAGE_USER_BURST=4
# IMAGE_TIMEOUT_MS=25000
